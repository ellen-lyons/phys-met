# ==========================================
# Jupyter Notebook Files
# ==========================================
# Ignore auto-saved checkpoint files created by Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Ignore export/conversion outputs
*.html
*.pdf

# Optional: Ignore all notebook execution outputs (if using tools like nbstripout)
# *.nbconvert.ipynb


# ==========================================
# Python Files & Cache
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg


# ==========================================
# Virtual Environments
# ==========================================
# Ignore local Python environments so you don't upload gigabytes of packages
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/


# ==========================================
# Data & Large Files (Uncomment if needed)
# ==========================================
# Ignore datasets or large files that shouldn't be tracked in Git
# *.csv
# *.json
# *.parquet
# *.zip
# *.tar.gz
# data/


# ==========================================
# Environment Variables & Secrets
# ==========================================
# Keep credentials, API keys, and secret configurations local
.env
.env.local
.env.*.local


# ==========================================
# OS & Editor Specific Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

# VS Code / PyCharm settings
.vscode/
.idea/
